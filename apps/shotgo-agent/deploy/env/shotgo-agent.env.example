# The Gateway must stay on loopback. Nginx is the only public listener.
SHOTGO_AGENT_HOST=127.0.0.1
SHOTGO_AGENT_PORT=3010

# Immutable release identifier, normally the deployed Git SHA.
SHOTGO_DEPLOYMENT_ID=replace-with-git-sha

# Keep false until Laravel v1 integration and end-to-end acceptance pass.
SHOTGO_ENABLE_TRAFFIC=false

NODE_ENV=production

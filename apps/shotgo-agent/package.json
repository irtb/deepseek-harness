{
  "name": "@shotgo/agent-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:gateway": "tsc -p tsconfig.deploy.json && node scripts/build-deploy-config.mjs",
    "build:release": "pnpm run build:gateway && node scripts/build-release-package.mjs",
    "dev": "node --import tsx/esm src/bin.ts",
    "dev:gateway": "node --import tsx/esm src/gateway-bin.ts",
    "start:gateway": "node dist/gateway-bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/shotgo-agent/tests",
    "test:contract": "vitest run --root ../.. apps/shotgo-agent/tests/laravel-contract.spec.ts apps/shotgo-agent/tests/gateway-contract.spec.ts",
    "test:gateway": "vitest run --root ../.. apps/shotgo-agent/tests/gateway.spec.ts apps/shotgo-agent/tests/gateway-session.spec.ts apps/shotgo-agent/tests/capability-grant-authorizer.spec.ts",
    "test:snapshot": "vitest run --root ../.. apps/shotgo-agent/tests/runtime.snapshot.spec.ts",
    "verify:isolation": "node scripts/verify-upstream-isolation.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-hmr": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-loop": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-llm-retry": "workspace:^",
    "@deepseek-ai/dsh-persona": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "execa": "^10.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}

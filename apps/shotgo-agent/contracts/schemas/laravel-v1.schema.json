{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.shotgo.cn/contracts/laravel-v1.schema.json",
  "title": "ShotGo Laravel Agent Protocol v1",
  "$defs": {
    "ProtocolVersion": { "const": "2026-08-26.1" },
    "OpaqueId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "OpaqueToken": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "IntegerId": { "type": "integer", "minimum": 1 },
    "DateTime": { "type": "string", "format": "date-time" },
    "AgentMode": { "enum": ["canvas", "image", "video"] },
    "AssetKind": { "enum": ["text", "image", "video", "audio"] },
    "GenerationKind": { "enum": ["image", "video"] },
    "InferenceModel": { "enum": ["deepseek-v4-flash", "deepseek-v4-pro"] },
    "AgentSessionCapability": { "enum": ["agent.session.submit", "agent.session.events.read", "agent.session.cancel", "agent.session.approval.respond"] },
    "AgentCapability": { "type": "string", "minLength": 1, "maxLength": 255 },
    "NullableOpaqueId": { "oneOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }] },
    "NullableIntegerId": { "oneOf": [{ "$ref": "#/$defs/IntegerId" }, { "type": "null" }] },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "MutationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "runId", "actionId", "clientRequestId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "runId": { "$ref": "#/$defs/OpaqueId" },
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "clientRequestId": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "AgentGrantCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "agentMode"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "spaceId": { "$ref": "#/$defs/NullableOpaqueId" },
        "projectId": { "$ref": "#/$defs/NullableOpaqueId" },
        "agentMode": { "$ref": "#/$defs/AgentMode" }
      }
    },
    "AgentGrantCreateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "grantToken", "expiresAt", "sessionId", "userId", "teamId", "spaceId", "projectId", "agentMode", "allowedCapabilities"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "grantToken": { "$ref": "#/$defs/OpaqueToken" },
        "expiresAt": { "$ref": "#/$defs/DateTime" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "userId": { "$ref": "#/$defs/IntegerId" },
        "teamId": { "$ref": "#/$defs/NullableIntegerId" },
        "spaceId": { "$ref": "#/$defs/NullableOpaqueId" },
        "projectId": { "$ref": "#/$defs/NullableOpaqueId" },
        "agentMode": { "$ref": "#/$defs/AgentMode" },
        "allowedCapabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/AgentCapability" }, "uniqueItems": true }
      }
    },
    "AgentGrantIntrospectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantToken", "sessionId", "requiredCapability"],
      "properties": {
        "grantToken": { "$ref": "#/$defs/OpaqueToken" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "requiredCapability": { "$ref": "#/$defs/AgentSessionCapability" }
      }
    },
    "AgentGrantIntrospectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "active", "authorizationContextId", "subjectId", "expiresAt", "sessionId", "userId", "teamId", "spaceId", "projectId", "agentMode", "allowedCapabilities", "inferencePolicy"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "active": { "const": true },
        "authorizationContextId": { "$ref": "#/$defs/OpaqueId" },
        "subjectId": { "$ref": "#/$defs/OpaqueId" },
        "expiresAt": { "$ref": "#/$defs/DateTime" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "userId": { "$ref": "#/$defs/IntegerId" },
        "teamId": { "$ref": "#/$defs/NullableIntegerId" },
        "spaceId": { "$ref": "#/$defs/NullableOpaqueId" },
        "projectId": { "$ref": "#/$defs/NullableOpaqueId" },
        "agentMode": { "$ref": "#/$defs/AgentMode" },
        "allowedCapabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/AgentCapability" }, "uniqueItems": true },
        "inferencePolicy": { "$ref": "#/$defs/InferencePolicy" }
      }
    },
    "GenerationConfigReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantToken", "sessionId", "kind"],
      "properties": {
        "grantToken": { "$ref": "#/$defs/OpaqueId" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "kind": { "$ref": "#/$defs/GenerationKind" }
      }
    },
    "GenerationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "boolean" },
        "credits": { "type": "number", "minimum": 0 }
      }
    },
    "GenerationRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "GenerationConfigModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "vip"],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "label": { "type": "string", "minLength": 1 },
        "shortLabel": { "type": "string", "minLength": 1 },
        "badge": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "credits": { "type": "number", "minimum": 0 },
        "vip": { "type": "boolean" },
        "supportedOptions": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } },
        "optionOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "credits": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "operationOptionConstraints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "durationRange": { "$ref": "#/$defs/GenerationRange" },
        "fpsEnabled": { "type": "boolean" },
        "fpsRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minFps", "maxFps"],
            "properties": {
              "minFps": { "type": "number", "minimum": 0 },
              "maxFps": { "type": "number", "minimum": 0 },
              "credits": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "ImageGenerationParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualities", "resolutions", "aspectRatios"],
      "properties": {
        "qualities": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } },
        "resolutions": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } },
        "aspectRatios": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } }
      }
    },
    "VideoGenerationParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatios", "resolutions", "duration", "fps", "audioOptions", "operationTypes"],
      "properties": {
        "aspectRatios": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } },
        "resolutions": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } },
        "duration": { "$ref": "#/$defs/GenerationRange" },
        "fps": { "$ref": "#/$defs/GenerationRange" },
        "audioOptions": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } },
        "operationTypes": { "type": "array", "items": { "$ref": "#/$defs/GenerationOption" } }
      }
    },
    "ImageGenerationDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelId": { "$ref": "#/$defs/OpaqueId" },
        "qualityId": { "$ref": "#/$defs/OpaqueId" },
        "resolutionId": { "$ref": "#/$defs/OpaqueId" },
        "aspectRatioId": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "VideoGenerationDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelId": { "$ref": "#/$defs/OpaqueId" },
        "aspectRatioId": { "$ref": "#/$defs/OpaqueId" },
        "resolutionId": { "$ref": "#/$defs/OpaqueId" },
        "duration": { "type": "integer", "minimum": 0 },
        "audio": { "type": "boolean" }
      }
    },
    "GenerationConfigReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "parameterSchemaVersion", "authorizationContextId", "sessionId", "kind", "models", "parameters", "defaults"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "image" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/$defs/ImageGenerationParameters" },
              "defaults": { "$ref": "#/$defs/ImageGenerationDefaults" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "video" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/$defs/VideoGenerationParameters" },
              "defaults": { "$ref": "#/$defs/VideoGenerationDefaults" }
            }
          }
        }
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "parameterSchemaVersion": { "const": 1 },
        "authorizationContextId": { "$ref": "#/$defs/OpaqueId" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "kind": { "$ref": "#/$defs/GenerationKind" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/GenerationConfigModel" }
        },
        "parameters": { "oneOf": [{ "$ref": "#/$defs/ImageGenerationParameters" }, { "$ref": "#/$defs/VideoGenerationParameters" }] },
        "defaults": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "CapabilityCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "catalogVersion", "models"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "catalogVersion": { "$ref": "#/$defs/OpaqueId" },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modelId", "kind", "displayName", "inputSchema", "enabled"],
            "properties": {
              "modelId": { "$ref": "#/$defs/OpaqueId" },
              "kind": { "$ref": "#/$defs/AssetKind" },
              "displayName": { "type": "string", "minLength": 1 },
              "inputSchema": { "type": "object" },
              "enabled": { "type": "boolean" }
            }
          }
        }
      }
    },
    "QuoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "kind", "modelId", "parameters"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "kind": { "$ref": "#/$defs/GenerationKind" },
        "modelId": { "$ref": "#/$defs/OpaqueId" },
        "parameters": {
          "type": "object",
          "properties": { "referenceAssets": { "$ref": "#/$defs/ReferenceAssets" } },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "QuoteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "quoteId", "quoteVersion", "kind", "modelId", "credits", "breakdown", "canAfford", "userBalance", "expiresAt", "normalizedParameters", "requiresConfirmation"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "quoteId": { "$ref": "#/$defs/OpaqueToken" },
        "quoteVersion": { "const": 1 },
        "kind": { "$ref": "#/$defs/GenerationKind" },
        "modelId": { "$ref": "#/$defs/OpaqueId" },
        "credits": { "type": "integer", "minimum": 0 },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "credits"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "credits": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "canAfford": { "type": "boolean" },
        "userBalance": { "type": "integer", "minimum": 0 },
        "expiresAt": { "$ref": "#/$defs/DateTime" },
        "normalizedParameters": {
          "type": "object",
          "properties": { "referenceAssets": { "$ref": "#/$defs/ReferenceAssets" } },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "requiresConfirmation": { "const": true }
      }
    },
    "GenerationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "quoteId", "quoteVersion"],
      "properties": {
        "context": { "$ref": "#/$defs/MutationContext" },
        "quoteId": { "$ref": "#/$defs/OpaqueToken" },
        "quoteVersion": { "const": 1 }
      }
    },
    "ReferenceAssets": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaLibraryItemId"],
        "properties": { "mediaLibraryItemId": { "type": "integer", "minimum": 1 } }
      }
    },
    "GenerationState": { "enum": ["draft", "creating", "queued", "processing", "completed", "failed", "cancelled"] },
    "GenerationAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "kind", "url", "sizeBytes"],
      "properties": {
        "assetId": { "$ref": "#/$defs/OpaqueId" },
        "kind": { "enum": ["image", "video", "audio"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "generationId", "clientRequestId", "operationId", "state", "stage", "credits", "userBalance", "replayed", "createdAt", "updatedAt"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "generationId": { "$ref": "#/$defs/OpaqueId" },
        "clientRequestId": { "$ref": "#/$defs/OpaqueId" },
        "operationId": { "$ref": "#/$defs/OpaqueId" },
        "state": { "$ref": "#/$defs/GenerationState" },
        "stage": { "type": "string", "minLength": 1 },
        "credits": { "type": "integer", "minimum": 0 },
        "userBalance": { "type": "integer", "minimum": 0 },
        "replayed": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/DateTime" },
        "updatedAt": { "$ref": "#/$defs/DateTime" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/GenerationAsset" } },
        "failureCode": { "type": "string" }
      }
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context"],
      "properties": { "context": { "$ref": "#/$defs/MutationContext" } }
    },
    "CanvasSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "canvasId", "revision", "nodes", "edges"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "canvasId": { "$ref": "#/$defs/OpaqueId" },
        "revision": { "type": "integer", "minimum": 0 },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      }
    },
    "CanvasApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "expectedRevision", "operations", "confirmedAt"],
      "properties": {
        "context": { "$ref": "#/$defs/MutationContext" },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } } },
        "confirmedAt": { "$ref": "#/$defs/DateTime" }
      }
    },
    "CanvasApplyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "canvasId", "previousRevision", "revision", "operationId"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "canvasId": { "$ref": "#/$defs/OpaqueId" },
        "previousRevision": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 1 },
        "operationId": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "InferencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "policyVersion", "provider", "allowedModels", "defaultModel", "defaultReasoningEffort", "maxOutputTokens", "sessionTokenBudget", "expiresAt"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "policyVersion": { "$ref": "#/$defs/OpaqueId" },
        "provider": { "const": "volcengine-ark" },
        "allowedModels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/InferenceModel" } },
        "defaultModel": { "$ref": "#/$defs/InferenceModel" },
        "defaultReasoningEffort": { "enum": ["off", "high", "max"] },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "sessionTokenBudget": { "type": "integer", "minimum": 1 },
        "expiresAt": { "$ref": "#/$defs/DateTime" }
      }
    },
    "InferenceRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "configurationVersion", "provider", "baseURL", "apiKey", "models"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "configurationVersion": { "$ref": "#/$defs/OpaqueId" },
        "provider": { "const": "volcengine-ark" },
        "baseURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "apiKey": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deepseek-v4-flash", "deepseek-v4-pro"],
          "properties": {
            "deepseek-v4-flash": { "type": "string", "minLength": 1, "maxLength": 255 },
            "deepseek-v4-pro": { "type": "string", "minLength": 1, "maxLength": 255 }
          }
        }
      }
    },
    "InferenceUsageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "llmRequestId", "sessionId", "provider", "model", "status", "startedAt", "completedAt", "durationMs", "usage"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "llmRequestId": { "$ref": "#/$defs/OpaqueId" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "runId": { "$ref": "#/$defs/OpaqueId" },
        "purpose": { "type": "string", "maxLength": 255 },
        "provider": { "const": "volcengine-ark" },
        "model": { "$ref": "#/$defs/InferenceModel" },
        "status": { "enum": ["completed", "failed", "cancelled"] },
        "startedAt": { "$ref": "#/$defs/DateTime" },
        "completedAt": { "$ref": "#/$defs/DateTime" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "cacheReadTokens": { "type": "integer", "minimum": 0 },
            "cacheWriteTokens": { "type": "integer", "minimum": 0 },
            "reasoningTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "providerRequestId": { "type": "string", "maxLength": 255 },
        "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "AgentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "eventId", "projectId", "sequence", "operationId", "occurredAt", "type", "payload"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "eventId": { "$ref": "#/$defs/OpaqueId" },
        "projectId": { "$ref": "#/$defs/OpaqueId" },
        "sequence": { "type": "integer", "minimum": 1 },
        "operationId": { "$ref": "#/$defs/OpaqueId" },
        "occurredAt": { "$ref": "#/$defs/DateTime" },
        "type": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "title", "status", "code", "retryable", "requestId"],
      "properties": {
        "type": { "type": "string", "format": "uri-reference" },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "retryable": { "type": "boolean" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "details": { "type": "object" }
      }
    }
  }
}

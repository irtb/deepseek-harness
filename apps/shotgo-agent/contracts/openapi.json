{
  "openapi": "3.1.0",
  "info": {
    "title": "ShotGo Laravel Agent Protocol",
    "version": "2026-08-26.1",
    "description": "Frozen Agent Runtime to Laravel control-plane and AIGC capability protocol. Harness calls the approved reasoning provider directly with service-only runtime configuration from Laravel; Laravel remains the policy, budget, audit, and business authority."
  },
  "servers": [{ "url": "https://shotgo.cn" }],
  "tags": [
    { "name": "Authentication" },
    { "name": "Inference" },
    { "name": "Generation" },
    { "name": "Canvas" },
    { "name": "Events" }
  ],
  "paths": {
    "/api/agent/v1/grants": {
      "post": {
        "operationId": "createAgentCapabilityGrant",
        "tags": ["Authentication"],
        "description": "Issue a short-lived capability grant from the authenticated Canvas user context. User and team identities are derived from Sanctum by Laravel rather than accepted from the request body.",
        "security": [{ "sanctumAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AgentGrantCreateRequest" } } } },
        "responses": {
          "200": { "description": "Opaque short-lived capability grant", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AgentGrantCreateResponse" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/internal/agent/v1/grants/introspect": {
      "post": {
        "operationId": "introspectAgentCapabilityGrant",
        "tags": ["Authentication"],
        "description": "Validate one opaque grant, requested Session, and required Gateway capability under Agent service authentication. The response is authoritative and must not be cached.",
        "security": [{ "serviceAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AgentGrantIntrospectionRequest" } } } },
        "responses": {
          "200": { "description": "Authoritative authorization context, complete capability set, and nested inference policy", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AgentGrantIntrospectionResponse" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/internal/agent/v1/generation/config": {
      "post": {
        "operationId": "readAgentGenerationConfig",
        "tags": ["Generation"],
        "description": "Read the Laravel-authoritative generation catalog for one Session and opaque capability grant. The service-authenticated response is read-only and must not be cached.",
        "security": [{ "serviceAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/GenerationConfigReadRequest" } } } },
        "responses": {
          "200": { "description": "Visible models, safe parameter constraints, and defaults for the grant subject; catalog credit metadata is not a quote", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/GenerationConfigReadResponse" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/capabilities": {
      "get": {
        "operationId": "readAgentCapabilityCatalog",
        "tags": ["Generation"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "name": "kind", "in": "query", "required": false, "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AssetKind" } }],
        "responses": {
          "200": { "description": "Models visible to the current grant", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/CapabilityCatalog" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/inference-policy": {
      "get": {
        "operationId": "readAgentInferencePolicy",
        "tags": ["Inference"],
        "description": "Read the short-lived Laravel policy that constrains direct Harness inference. This endpoint never returns provider credentials.",
        "security": [{ "capabilityGrant": [] }],
        "responses": {
          "200": { "description": "Effective inference policy for this grant", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/InferencePolicy" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/internal/agent/v1/inference-runtime-config": {
      "get": {
        "operationId": "readAgentInferenceRuntimeConfig",
        "tags": ["Inference"],
        "description": "Return the encrypted-at-rest provider credential and logical-to-provider model mapping only to the authenticated Agent service. Responses must not be cached or logged.",
        "security": [{ "serviceAuth": [] }],
        "responses": {
          "200": { "description": "Complete runtime configuration for direct provider inference", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/InferenceRuntimeConfig" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/internal/agent/v1/inference-usage": {
      "post": {
        "operationId": "reportAgentInferenceUsage",
        "tags": ["Inference"],
        "description": "Idempotently record metadata and token usage for a direct provider call. Prompts, completions, and provider credentials are forbidden.",
        "security": [{ "serviceAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/InferenceUsageIdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/InferenceUsageReport" } } } },
        "responses": {
          "202": { "description": "Usage accepted or replayed idempotently", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/generation-quotes": {
      "post": {
        "operationId": "createGenerationQuote",
        "tags": ["Generation"],
        "description": "Return a short-lived Laravel-authoritative credit quote without charging credits, creating a generation record, or dispatching work. The response must not be cached.",
        "security": [{ "capabilityGrant": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/QuoteRequest" } } } },
        "responses": {
          "200": { "description": "Authoritative quote requiring user confirmation", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/QuoteResponse" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/generations": {
      "post": {
        "operationId": "createGeneration",
        "tags": ["Generation"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/GenerationCreateRequest" } } } },
        "responses": {
          "202": { "description": "Generation accepted or replayed idempotently", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Generation" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/generations/by-client-request/{clientRequestId}": {
      "get": {
        "operationId": "recoverGenerationByClientRequestId",
        "tags": ["Generation"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "name": "clientRequestId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Authoritative result for unknown mutation outcome recovery", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Generation" } } } },
          "404": { "$ref": "#/components/responses/Problem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/generations/{generationId}": {
      "get": {
        "operationId": "readGeneration",
        "tags": ["Generation"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/GenerationId" }],
        "responses": {
          "200": { "description": "Authoritative generation state", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Generation" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/generations/{generationId}/cancel": {
      "post": {
        "operationId": "cancelGeneration",
        "tags": ["Generation"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/GenerationId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/CancelRequest" } } } },
        "responses": {
          "200": { "description": "Final Laravel state after cancellation race resolution", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Generation" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/canvases/{canvasId}": {
      "get": {
        "operationId": "readCanvasSnapshot",
        "tags": ["Canvas"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CanvasId" }],
        "responses": {
          "200": { "description": "Authoritative revisioned canvas snapshot", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/CanvasSnapshot" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/canvases/{canvasId}/operations": {
      "post": {
        "operationId": "applyCanvasOperations",
        "tags": ["Canvas"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CanvasId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/CanvasApplyRequest" } } } },
        "responses": {
          "200": { "description": "Operations applied against expected revision", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/CanvasApplyResponse" } } } },
          "409": { "description": "CANVAS_REVISION_CONFLICT; reread and replan", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/problem+json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Problem" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/agent/v1/events": {
      "get": {
        "operationId": "streamAgentEvents",
        "tags": ["Events"],
        "security": [{ "capabilityGrant": [] }],
        "parameters": [
          { "name": "projectId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Replayable SSE events ordered by project sequence", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "text/event-stream": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/AgentEvent" } } } },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctumAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Laravel Sanctum token" },
      "serviceAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque-service-token" },
      "capabilityGrant": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque-capability-grant" }
    },
    "headers": {
      "ProtocolVersion": { "required": true, "schema": { "type": "string", "const": "2026-08-26.1" } }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "description": "Must equal body context.clientRequestId", "schema": { "type": "string", "minLength": 1 } },
      "InferenceUsageIdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "description": "Must equal body llmRequestId", "schema": { "type": "string", "minLength": 1 } },
      "GenerationId": { "name": "generationId", "in": "path", "required": true, "schema": { "type": "string" } },
      "CanvasId": { "name": "canvasId", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "Problem": { "description": "Stable machine-readable protocol error", "headers": { "X-ShotGo-Protocol-Version": { "$ref": "#/components/headers/ProtocolVersion" } }, "content": { "application/problem+json": { "schema": { "$ref": "./schemas/laravel-v1.schema.json#/$defs/Problem" } } } }
    }
  }
}

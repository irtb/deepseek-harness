# Vite 按 mode 加载：
#   .env.development  → pnpm --filter @shotgo/agent-web dev（本机 3011）
#   .env.production   → 发布包 vite build
# 本地覆盖用 .env.development.local（不要提交）
#
# 开发态不要设置 VITE_SHOTGO_GATEWAY_BASE_URL：浏览器走同源 /api/agent，
# Vite 代理到 127.0.0.1:3012。跨源直连 3012 会 Failed to fetch。

VITE_SHOTGO_API_BASE_URL=http://127.0.0.1:8000
VITE_SHOTGO_RESOURCE_BASE_URL=http://127.0.0.1:8000
VITE_CANVAS_APP_BASE_URL=https://canvas.shotgo.cn
